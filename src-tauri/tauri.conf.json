{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sympony",
  "version": "0.3.0-beta.1",
  "identifier": "app.sympony",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "../brand/icon.icns",
      "../brand/icon.ico",
      "../brand/icon-1024.png"
    ],
    "resources": {
      "../crates/voice/data/**/*": "voice/data/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installerIcon": "../brand/icon.ico",
        "uninstallerIcon": "../brand/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1MzY4N0RBRjAxNzhCRTkKUldUcGl4Zncyb2MyVlI2Z2dRNFNTbUkvNUk4N3JDWWhpd0xpbHhWTmNIb1Fha084STNtbEJPQ1AK",
      "endpoints": [
        "https://github.com/rheynoapria/sympony-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
